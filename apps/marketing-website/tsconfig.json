{
  "extends": "@lurniva/typescript-config/react-app.json",
  "compilerOptions": {
    "types": [],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "jsx": "preserve"
  },
  "include": [
    "src",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
