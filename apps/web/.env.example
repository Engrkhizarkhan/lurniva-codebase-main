VITE_SUPABASE_URL=""
VITE_SUPABASE_KEY=""
CLIENT_SECRET=tJWlfCud6G2J15lZ #Client Secret to use with the OAuth flow on the web.

# Server-only (never VITE_-prefixed — must not reach the browser bundle).
SUPABASE_SERVICE_ROLE_KEY=""
ZEPTOMAIL_API_KEY=""
ZEPTOMAIL_FROM_EMAIL=""
ZEPTOMAIL_FROM_NAME=""
SITE_URL="http://localhost:3000"

# AI provider (used by apps/web server routes and apps/model). When these are
# unset the web app keeps using its offline mock provider. Exactly the same
# two keys also power apps/model (see apps/model/.env.example).
OPENAI_API_KEY=""
MODEL_NAME="gpt-4o-mini"
# Optional OpenAI-compatible base URL (OpenRouter, local gateway, …).
OPENAI_BASE_URL=""
# Optional per-call token cap.
MODEL_MAX_TOKENS="2048"
# Additional models the study composer can switch to (comma-separated ids).
# "default" always maps to MODEL_NAME above.
AI_MODELS="gpt-4o-mini,gpt-4.1-mini,gpt-4o"
# Base URL of the apps/model distillation service (book upload → structured
# skill). Must be running locally (pnpm --filter @lurniva/model dev) for
# library uploads / day content attachment to work.
MODEL_APP_URL="http://localhost:4000"

# TEMPORARY: set to "true" to auto-confirm signups instead of emailing a
# verification link (e.g. while the email provider is unavailable).
SKIP_EMAIL_VERIFICATION="true"

# See packages/db/.env.example for connection string details (Supabase Postgres).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
