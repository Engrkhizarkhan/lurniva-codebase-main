# Model service configuration — copy to .env and fill in real values.

# Your OpenAI API key (or any OpenAI-compatible provider key).
OPENAI_API_KEY=""

# The model to use, e.g. "gpt-4o-mini", "gpt-4o", or another provider model id.
MODEL_NAME="gpt-4o-mini"

# Optional: point at any OpenAI-compatible gateway (OpenRouter, local dev gateway…).
# Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=""

# Optional guard on per-call generation (tokens).
MODEL_MAX_TOKENS="2048"

# Port of the model service dev server (matches apps/model/package.json).
MODEL_PORT="4000"