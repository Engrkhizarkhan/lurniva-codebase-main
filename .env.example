# General env shared across all apps.
# Copy to .env and fill in.

# --- Model service (apps/model) ---
# The model app reads these from apps/model/.env. The web app falls back
# to its mock AI when they are absent here too.
OPENAI_API_KEY=""
MODEL_NAME="gpt-4o-mini"

# Optional: OpenAI-compatible base URL override (OpenRouter, local gateway…)
OPENAI_BASE_URL=""

# Additional models the study composer can switch to (comma-separated ids).
AI_MODELS="gpt-4o-mini,gpt-4.1-mini,gpt-4o"

# Web has its OWN .env at apps/web/.env (VITE_* etc.). Root .env is loaded via dotenv
# in the web/model app configs; per-app .env files take precedence.